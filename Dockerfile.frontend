
# Stage 1: Dependencies
FROM node:22-alpine AS deps

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

# Stage 2: Build
FROM node:22-alpine AS builder

WORKDIR /app

COPY --from=deps /app/node_modules ./node_modules
COPY . .

ENV NEXT_TELEMETRY_DISABLED=1
ARG NEXT_PUBLIC_API_URL=https://api.example.invalid
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}

RUN npm run build

# Stage 3: Production runtime
FROM node:22-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

RUN addgroup -S worksphere && adduser -S worksphere -G worksphere

COPY --from=builder --chown=worksphere:worksphere /app/public ./public
COPY --from=builder --chown=worksphere:worksphere /app/.next/standalone ./
COPY --from=builder --chown=worksphere:worksphere /app/.next/static ./.next/static

USER worksphere

EXPOSE 3000

CMD ["node", "server.js"]
