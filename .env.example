PORT=5000

# PostgreSQL Database
DATABASE_URL=postgresql://postgres:your_postgres_password@localhost:5432/worksphere_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=worksphere_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password
# Use at least 32 URL-safe characters (letters, digits, "_" or "-").
# The API and worker use this separate least-privilege database role in Compose.
WORKSPHERE_APP_PASSWORD=replace_with_32_or_more_url_safe_characters

# Frontend API base URL (baked into the frontend build)
NEXT_PUBLIC_API_URL=http://localhost:5000

# JWT Authentication
JWT_SECRET=replace-with-a-secure-random-secret
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=7
API_RATE_LIMIT_MAX_REQUESTS=100
API_RATE_LIMIT_WINDOW_SECONDS=900
TRUST_PROXY_HOPS=0

# Resend Email Integration
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=WorkSphere <onboarding@resend.dev>
RESEND_WEBHOOK_SECRET=whsec_replace_with_your_webhook_secret

# S3-Compatible Object Storage
AWS_REGION=your_aws_region
S3_BUCKET=your_bucket_name
S3_ACCESS_KEY_ID=your_access_key
S3_SECRET_ACCESS_KEY=your_secret_key
S3_ENDPOINT=
# Redis
REDIS_URL=redis://localhost:6379
