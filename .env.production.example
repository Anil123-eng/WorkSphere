# WorkSphere - Production Environment
NODE_ENV=production
PORT=5000

# PostgreSQL
# Use the Render internal connection URL. Do not use the external database URL.
DATABASE_URL=postgresql://user:password@your-internal-postgres-host:5432/worksphere_production
NEXT_PUBLIC_API_URL=https://your-production-backend.onrender.com

# Redis
# Use the Render internal Key Value URL.
REDIS_URL=redis://your-internal-key-value-host:6379

# JWT
JWT_SECRET=replace_with_a_long_random_production_secret
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=7
TRUST_PROXY_HOPS=1
API_RATE_LIMIT_MAX_REQUESTS=100
API_RATE_LIMIT_WINDOW_SECONDS=900

# Email
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_WEBHOOK_SECRET=

# S3 Storage
AWS_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
