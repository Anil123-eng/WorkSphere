# WorkSphere - Staging Environment
NODE_ENV=production
PORT=5000

# PostgreSQL
DB_HOST=postgres
DB_PORT=5432
DB_NAME=worksphere_staging
DB_USER=postgres
DB_PASSWORD=replace_with_staging_password

# Redis
REDIS_URL=redis://redis:6379

# JWT
JWT_SECRET=replace_with_a_secure_staging_secret
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=7

# Email
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_WEBHOOK_SECRET=

# S3 Storage
AWS_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
